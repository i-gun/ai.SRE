# ============================================================================
# Example environment configuration (sanitized)
# Do not use real credentials here.
# ============================================================================

# Git identity
GIT_USER_NAME=Jane Developer
GIT_USER_EMAIL=jane.developer@example.com

# GitHub auth
GITHUB_AUTH_METHOD=ssh
GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519
GITHUB_SSH_PASSPHRASE=
GITHUB_TOKEN=

# GPG signing
GPG_SIGNING_ENABLED=false
GPG_KEY_ID=
GPG_SIGNING_KEY_PATH=

# Environment profile
ENVIRONMENT_PROFILE=dev

# ServiceNow incident operations
SERVICENOW_HOST=https://your-instance.service-now.com
SERVICENOW_USERNAME=sn_integration_user
SERVICENOW_PASSWORD=replace-with-secure-password
SERVICENOW_ASSIGNMENT_GROUPS=Network Operations,Service Desk

# Jira Cloud issue operations
JIRA_HOST=https://your-domain.atlassian.net
JIRA_USERNAME=automation.user@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
CONFLUENCE_SPACE_KEY=PLATFORM,DEV

# New Relic log operations
NEWRELIC_API_KEY=NRAK-replace-with-real-api-key
NEWRELIC_ACCOUNT_IDS=1234567,2345678

# Azure DevOps Git read-only operations
AZURE_ORG=my_org
AZURE_PROJECT=project_1,project_2
AZURE_PAT=replace-with-read-only-pat
AZURE_API_VERSION=7.1
AZURE_REPO_MAP_MAX_AGE_HOURS=24

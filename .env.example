# ============================================================================
# Example environment configuration (sanitized)
# Do not use real credentials here.
# ============================================================================

# Git identity
GIT_USER_NAME=Jane Developer
GIT_USER_EMAIL=jane.developer@example.com
GIT_PROTECTED_BRANCHES=main,master,release/*

# GitHub auth
GITHUB_AUTH_METHOD=ssh
GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519
GITHUB_SSH_PASSPHRASE=
GITHUB_TOKEN=

# GPG signing
GPG_SIGNING_ENABLED=false
GPG_KEY_ID=
GPG_SIGNING_KEY_PATH=

# Environment profile
ENVIRONMENT_PROFILE=dev

# ServiceNow incident operations
SERVICENOW_HOST=https://your-instance.service-now.com
# Select basic (default) or oauth_client_credentials; no automatic fallback.
SERVICENOW_AUTH_MODE=basic
# Basic credentials; username may also supply a caller/assignee identity in OAuth mode.
SERVICENOW_USERNAME=sn_integration_user
SERVICENOW_PASSWORD=replace-with-secure-password
# Required only when SERVICENOW_AUTH_MODE=oauth_client_credentials.
# The platform maps this application to the service account; no user password is sent.
SERVICENOW_CLIENT_ID=replace-with-oauth-client-id
SERVICENOW_CLIENT_SECRET="replace-with-oauth-client-secret"
# Match the administrator-confirmed method: client_secret_post or client_secret_basic.
SERVICENOW_OAUTH_CLIENT_AUTH_METHOD=client_secret_post
# Optional: blank defaults to the instance's /oauth_token.do endpoint (HTTPS, same origin).
SERVICENOW_TOKEN_URL=
# Optional: leave blank unless administrators specify a scope.
SERVICENOW_OAUTH_SCOPE=
SERVICENOW_ASSIGNMENT_GROUPS=Network Operations,Service Desk
# See docs/SERVICENOW_AUTHENTICATION.md; live OAuth testing is a separate step.

# Jira Cloud issue operations
JIRA_HOST=https://your-domain.atlassian.net
JIRA_USERNAME=automation.user@example.com
JIRA_API_TOKEN=replace-with-jira-api-token
CONFLUENCE_SPACE_KEY=PLATFORM,DEV

# New Relic log operations
NEWRELIC_API_KEY=NRAK-replace-with-real-api-key
NEWRELIC_ACCOUNT_IDS=1234567,2345678

# Dynatrace log & monitoring operations
DYNATRACE_ENVIRONMENT_URL=https://abc12345.live.dynatrace.com
DYNATRACE_API_TOKEN=dt0c01.replace-with-real-api-token
DYNATRACE_USERNAME=automation.user@example.com

# Corporate TLS interception CA bundle (only needed behind an SSL-decryption proxy)
REQUESTS_CA_BUNDLE=certs/CTE_SSLDECRYPTION_SUBCA_2028.pem

# Azure DevOps Git read-only operations
AZURE_ORG=my_org
AZURE_PROJECT=project_1,project_2
AZURE_PAT=replace-with-read-only-pat
AZURE_API_VERSION=7.1
AZURE_REPO_MAP_MAX_AGE_HOURS=24

# Emailer (local Outlook desktop COM automation — no auth secrets required)
EMAILER_MAILBOX_ADDRESS=
EMAILER_WATCHED_FOLDERS=Inbox,Project/CTC/Alerts
EMAILER_ALLOWED_RECIPIENT_DOMAINS=
EMAILER_SEND_MODE=draft_review
EMAILER_REDACTION_RULESET_PATH=scripts/emailer/redaction_rules.json

# AzurePortal read-only monitoring (Azure public cloud)
AZUREPORTAL_AUTH_MODE=azure_cli
AZUREPORTAL_TENANT_ID=aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa
AZUREPORTAL_SUBSCRIPTION_IDS=bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb
AZUREPORTAL_WORKSPACE_MAP={"cccccccc-cccc-4ccc-8ccc-cccccccccccc":"/subscriptions/bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb/resourceGroups/monitoring/providers/Microsoft.OperationalInsights/workspaces/example-workspace"}
AZUREPORTAL_RESOURCE_GROUPS=
AZUREPORTAL_RESOURCE_IDS=
AZUREPORTAL_CLIENT_ID=
AZUREPORTAL_CLIENT_SECRET=
AZUREPORTAL_MANAGED_IDENTITY_CLIENT_ID=
AZUREPORTAL_MAX_WINDOW_DAYS=30
AZUREPORTAL_MAX_ROWS=500
AZUREPORTAL_MAX_PAGES=5
AZUREPORTAL_TIMEOUT_SECONDS=30
AZUREPORTAL_MAX_CONCURRENT_REQUESTS=3

# ============================================================================
# Gitter Git Credentials Configuration Template
# ============================================================================
# SECURITY WARNING: This file contains sensitive information.
# NEVER commit this file to version control.
# Keep .env in .gitignore and store in secure location.
# ============================================================================

# ============================================================================
# REQUIRED: Git User Identity
# ============================================================================
# Your name and email used for all commits in this repository
GIT_USER_NAME=Your Full Name
GIT_USER_EMAIL=your.email@example.com

# ============================================================================
# GITHUB AUTHENTICATION METHOD
# ============================================================================
# Choose ONE method: 'https' (token), 'ssh' (keys), or 'auto' (both available)
GITHUB_AUTH_METHOD=ssh

# ============================================================================
# GITHUB HTTPS AUTHENTICATION (For HTTPS Git Operations)
# ============================================================================
# Personal Access Token: https://github.com/settings/tokens
# Scopes required: repo, read:user, user:email
# Leave empty if using SSH only
GITHUB_TOKEN=

# ============================================================================
# GITHUB CLI (gh) TOKEN — PULL REQUEST OPERATIONS (day-to-day, least-privilege)
# ============================================================================
# Dedicated token used ONLY by `gh` for Pull Request lifecycle operations
# (gh pr create / gh pr checks / gh pr merge) via the Gitter Pull Request
# Workflow prompt. Exported as GH_TOKEN at invocation time — never persisted
# via `gh auth login`.
#
# DO NOT reuse GITHUB_TOKEN (above) for this. Keep the two tokens separate:
#   GITHUB_TOKEN     -> administrative/one-off operations (e.g. branch
#                        protection setup). Broad scope, used rarely.
#   GITHUB_PR_TOKEN   -> routine PR automation. Narrow scope, used often.
#
# Fine-grained PAT scopes required (repository: this repo only):
#   Contents:      Read and write
#   Pull requests: Read and write
#   Metadata:      Read (default, always included)
# Do NOT grant Administration on this token — it is not needed for PR ops.
GITHUB_PR_TOKEN=

# ============================================================================
# GITHUB SSH AUTHENTICATION (For SSH Git Operations)
# ============================================================================
# Path to SSH private key (supports ~ for home directory)
# Recommended key types: ed25519 (modern) or rsa (legacy)
GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519

# Passphrase for encrypted SSH key (leave empty if key is unencrypted)
# WARNING: Storing passphrases in plaintext reduces security.
# Better practice: Use SSH agent to manage passphrases interactively
GITHUB_SSH_PASSPHRASE=

# ============================================================================
# GPG COMMIT SIGNING (Optional)
# ============================================================================
# Enable GPG signing on commits: true or false
GPG_SIGNING_ENABLED=false

# Your GPG key ID (appears in: gpg --list-secret-keys --keyid-format LONG)
# Example: 3AA5C34371567BD2 (16-character key ID)
GPG_KEY_ID=

# Path to GPG private key directory (optional, usually auto-detected)
# Typically: ~/.gnupg/private-keys-v1.d/
GPG_SIGNING_KEY_PATH=

# ============================================================================
# ENVIRONMENT PROFILES (Optional)
# ============================================================================
# Select active profile: dev, staging, or prod
# Profiles can override base configuration values
# Create .env.dev, .env.staging, .env.prod for profile-specific settings
ENVIRONMENT_PROFILE=dev

# ============================================================================
# PROTECTED BRANCHES (Gitter)
# ============================================================================
# Comma-separated list of branch names/patterns that must never receive
# direct commits or pushes. All changes to these branches must land via a
# Pull Request (see .github/skills/gitter-pull-request/SKILL.md).
# Supports simple glob patterns such as release/*.
GIT_PROTECTED_BRANCHES=main,master,release/*

# ============================================================================
# PROFILE-SPECIFIC OVERRIDES
# ============================================================================
# Uncomment and configure for specific profiles:
# Create separate files: .env.dev, .env.staging, .env.prod
#
# Example .env.dev (Development):
#   GIT_USER_EMAIL=dev.user@example.com
#   ENVIRONMENT_PROFILE=dev
#   GPG_SIGNING_ENABLED=false
#
# Example .env.prod (Production):
#   GIT_USER_EMAIL=prod.user@company.com
#   ENVIRONMENT_PROFILE=prod
#   GPG_SIGNING_ENABLED=true
#   GPG_KEY_ID=production-key-id

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 
# 1. Basic Setup (SSH):
#    GIT_USER_NAME=Your Name
#    GIT_USER_EMAIL=your@email.com
#    GITHUB_AUTH_METHOD=ssh
#    GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519
#
# 2. Generate SSH Key:
#    ssh-keygen -t ed25519 -C "your@email.com"
#    Add public key to GitHub: https://github.com/settings/keys
#
# 3. Test SSH Connection:
#    ssh -T git@github.com
#
# 4. Create Personal Access Token (HTTPS):
#    https://github.com/settings/tokens
#    Scopes: repo, read:user, user:email
#
# 5. Enable GPG Signing (Optional):
#    List keys: gpg --list-secret-keys --keyid-format LONG
#    Set GPG_SIGNING_ENABLED=true and add GPG_KEY_ID
#
# ============================================================================

# ============================================================================
# SERVICENOW INCIDENT OPERATIONS (Required for ServiceNow Agent)
# ============================================================================
# ServiceNow instance URL (must include protocol)
# Example: https://your-instance.service-now.com
SERVICENOW_HOST=

# Authentication mode: basic (default) or oauth_client_credentials
# Only the selected mode is used; there is no automatic fallback.
SERVICENOW_AUTH_MODE=basic

# Required for Basic auth; optional caller/assignee identity for OAuth workflows
SERVICENOW_USERNAME=

# Required for Basic auth only; never sent in OAuth mode
SERVICENOW_PASSWORD=

# Required for OAuth client credentials only (not the service account password)
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=

# OAuth token endpoint client authentication: client_secret_post or client_secret_basic
SERVICENOW_OAUTH_CLIENT_AUTH_METHOD=client_secret_post

# Optional OAuth settings; blank token URL defaults to <SERVICENOW_HOST>/oauth_token.do
# OAuth requires HTTPS and a token URL on the same origin as SERVICENOW_HOST.
SERVICENOW_TOKEN_URL=
# Leave blank unless administrators specify an exact scope value.
SERVICENOW_OAUTH_SCOPE=

# Comma-separated assignment group allowlist (names and/or sys_ids)
# Incidents outside this list will not be retrieved by ServiceNow skills/agent
SERVICENOW_ASSIGNMENT_GROUPS=

# ============================================================================
# SERVICENOW NOTES
# ============================================================================
# 1. Use a least-privilege account scoped to incident operations.
# 2. Never commit real credentials to version control.
# 3. Prefer a dedicated integration account over personal credentials.
# 4. Validate access to Incident table API before production use.
# 5. OAuth application mapping, roles, and ACLs must be configured by administrators.
# 6. Obtain OAuth credentials securely and request live testing separately.
# 7. See docs/SERVICENOW_AUTHENTICATION.md for configuration and mode switching.
# ============================================================================

# ============================================================================
# JIRA CLOUD ISSUE OPERATIONS (Required for Jira Agent)
# ============================================================================
# Jira Cloud site URL (must include protocol)
# Example: https://your-domain.atlassian.net
JIRA_HOST=

# Jira Cloud user identifier (typically Atlassian account email)
JIRA_USERNAME=

# Jira Cloud API token
JIRA_API_TOKEN=

# Confluence space key(s) used by the Confluence agent and skills.
# Accepts a single key or a comma-separated list of keys.
# Examples: PLATFORM  |  PLATFORM,DEV,OPS
CONFLUENCE_SPACE_KEY=

# ============================================================================
# JIRA NOTES
# ============================================================================
# 1. Use a least-privilege integration account or dedicated automation user.
# 2. Never commit real credentials to version control.
# 3. Prefer scoped API tokens over personal passwords.
# 4. Validate access to projects, dashboards, issues, and Confluence space content before production use.
# ============================================================================

# ============================================================================
# NEW RELIC LOG OPERATIONS (Required for NewRelic Agent)
# ============================================================================
# New Relic User API Key (starts with NRAK-)
# Generate at: https://one.newrelic.com/api-keys
NEWRELIC_API_KEY=

# Comma-separated list of New Relic Account IDs to query.
# Examples: 1234567  |  1234567,2345678,3456789
NEWRELIC_ACCOUNT_IDS=

# ============================================================================
# DYNATRACE LOG & MONITORING OPERATIONS (Required for Dynatrace Agent)
# ============================================================================
# Dynatrace environment base URL (must include protocol, no trailing slash)
# SaaS example: https://abc12345.live.dynatrace.com
# Managed example: https://your-cluster.example.com/e/<environment-id>
DYNATRACE_ENVIRONMENT_URL=

# Dynatrace API Token (Settings > Access Tokens)
# Generate at: {DYNATRACE_ENVIRONMENT_URL}/ui/apps/dynatrace.classic.tokens
# Required scopes: storage:logs:read, storage:events:read, storage:entities:read,
#                  problems.read, problems.write (comments only)
DYNATRACE_API_TOKEN=

# Username to record when posting audit-trail comments on problems
# (Dynatrace has no native "acknowledge" mutation; comments are the audit trail)
DYNATRACE_USERNAME=

# ============================================================================
# DYNATRACE NOTES
# ============================================================================
# 1. Use a least-privilege token scoped only to the read/comment permissions above.
# 2. Never commit real tokens to version control.
# 3. Acknowledgment is comment-based only; problem status (OPEN/CLOSED) is not
#    changed by this integration.
# 4. Validate token scopes against the target environment before production use.
# ============================================================================

# ============================================================================
# CORPORATE TLS INTERCEPTION - CA BUNDLE (required on networks behind SSL decryption)
# ============================================================================
# requests/urllib3 do not use the OS certificate store, so on networks with a
# corporate SSL-decryption proxy (e.g. Canadian Tire's CTE_SSLDECRYPTION_SUBCA_2028),
# API calls to Managed/on-prem-fronted endpoints (such as the Dynatrace environment
# above) fail with SSLError: CERTIFICATE_VERIFY_FAILED unless a CA bundle containing
# that proxy's chain is supplied explicitly.
# Place the resolved bundle at certs/<bundle-name>.pem (gitignored via *.pem) and
# point this at it. See docs/INTEGRATION_GOVERNANCE.md for diagnosis/remediation steps.
REQUESTS_CA_BUNDLE=certs/CTE_SSLDECRYPTION_SUBCA_2028.pem

# ============================================================================
# NEW RELIC NOTES
# ============================================================================
# 1. Use a User API Key (NRAK-...) for NerdGraph/NRQL access.
# 2. Never commit real API keys to version control.
# 3. Account IDs can be found under: Admin > Account settings.
# 4. Least-privilege: scope access to log and metric read permissions only.
# ============================================================================

# ============================================================================
# AZURE DEVOPS GIT READ-ONLY OPERATIONS (Required for AzureGit Agent)
# ============================================================================
# Azure DevOps organization name (not URL)
# Example: my_org
AZURE_ORG=

# Comma-separated project allowlist used for scoped read-only operations
# Examples: project_1  |  project_1,project_2
AZURE_PROJECT=

# Azure DevOps Personal Access Token (read-only scopes recommended)
AZURE_PAT=

# Optional API version (defaults to 7.1 when omitted)
AZURE_API_VERSION=7.1

# Optional repository mapping cache freshness threshold in hours.
# Used by scripts/azuregit/fetch_repo_map.py when --max-age-hours is omitted.
AZURE_REPO_MAP_MAX_AGE_HOURS=24

# ============================================================================
# AZURE DEVOPS NOTES
# ============================================================================
# 1. Use least-privilege PAT scopes focused on code read access.
# 2. Never commit real PAT values to version control.
# 3. Keep AZURE_PROJECT scoped to only projects you intend to query.
# 4. AZURE_API_VERSION is optional if using the default 7.1.
# 5. Use AZURE_REPO_MAP_MAX_AGE_HOURS to tune local mapping refresh cadence.
# ============================================================================

# ============================================================================
# AZUREPORTAL READ-ONLY AZURE MONITORING (AzurePortal Agent)
# ============================================================================
# Azure public cloud only. Select exactly one identity mode; no fallback:
# azure_cli, managed_identity, or service_principal.
AZUREPORTAL_AUTH_MODE=azure_cli
# Required Entra tenant and comma-separated subscription GUID allowlist.
AZUREPORTAL_TENANT_ID=
AZUREPORTAL_SUBSCRIPTION_IDS=

# JSON map: workspace GUID -> verified workspace ARM resource ID. Example:
# {"11111111-1111-4111-8111-111111111111":"/subscriptions/22222222-2222-4222-8222-222222222222/resourceGroups/monitoring/providers/Microsoft.OperationalInsights/workspaces/workspace-name"}
AZUREPORTAL_WORKSPACE_MAP={}

# Optional comma-separated exact resource-group and resource-ID allowlists.
# Subscription-wide alert/rule/Activity Log inventory is disabled when either
# narrower allowlist is configured, because those endpoints cannot enforce it.
AZUREPORTAL_RESOURCE_GROUPS=
AZUREPORTAL_RESOURCE_IDS=

# Conditional identity fields. Service principal mode requires client ID and
# secret; managed identity may optionally select a user-assigned client ID.
# Leave unused identity-mode fields blank. Never paste secrets into chat.
AZUREPORTAL_CLIENT_ID=
AZUREPORTAL_CLIENT_SECRET=
AZUREPORTAL_MANAGED_IDENTITY_CLIENT_ID=

# Finite query and network limits (bounded further by code):
AZUREPORTAL_MAX_WINDOW_DAYS=30
AZUREPORTAL_MAX_ROWS=500
AZUREPORTAL_MAX_PAGES=5
AZUREPORTAL_TIMEOUT_SECONDS=30
AZUREPORTAL_MAX_CONCURRENT_REQUESTS=3

# Minimum roles depend on operation: Resource Graph needs Reader/equivalent on
# scoped subscriptions; workspace queries need Log Analytics Reader or a
# narrower workspace data-plane role; Monitor Reader does not itself grant
# workspace query access. See docs/AZUREPORTAL.md and the authentication skill.
# ============================================================================

# ============================================================================
# Gitter Git Credentials Configuration Template
# ============================================================================
# SECURITY WARNING: This file contains sensitive information.
# NEVER commit this file to version control.
# Keep .env in .gitignore and store in secure location.
# ============================================================================

# ============================================================================
# REQUIRED: Git User Identity
# ============================================================================
# Your name and email used for all commits in this repository
GIT_USER_NAME=Your Full Name
GIT_USER_EMAIL=your.email@example.com

# ============================================================================
# GITHUB AUTHENTICATION METHOD
# ============================================================================
# Choose ONE method: 'https' (token), 'ssh' (keys), or 'auto' (both available)
GITHUB_AUTH_METHOD=ssh

# ============================================================================
# GITHUB HTTPS AUTHENTICATION (For HTTPS Git Operations)
# ============================================================================
# Personal Access Token: https://github.com/settings/tokens
# Scopes required: repo, read:user, user:email
# Leave empty if using SSH only
GITHUB_TOKEN=

# ============================================================================
# GITHUB SSH AUTHENTICATION (For SSH Git Operations)
# ============================================================================
# Path to SSH private key (supports ~ for home directory)
# Recommended key types: ed25519 (modern) or rsa (legacy)
GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519

# Passphrase for encrypted SSH key (leave empty if key is unencrypted)
# WARNING: Storing passphrases in plaintext reduces security.
# Better practice: Use SSH agent to manage passphrases interactively
GITHUB_SSH_PASSPHRASE=

# ============================================================================
# GPG COMMIT SIGNING (Optional)
# ============================================================================
# Enable GPG signing on commits: true or false
GPG_SIGNING_ENABLED=false

# Your GPG key ID (appears in: gpg --list-secret-keys --keyid-format LONG)
# Example: 3AA5C34371567BD2 (16-character key ID)
GPG_KEY_ID=

# Path to GPG private key directory (optional, usually auto-detected)
# Typically: ~/.gnupg/private-keys-v1.d/
GPG_SIGNING_KEY_PATH=

# ============================================================================
# ENVIRONMENT PROFILES (Optional)
# ============================================================================
# Select active profile: dev, staging, or prod
# Profiles can override base configuration values
# Create .env.dev, .env.staging, .env.prod for profile-specific settings
ENVIRONMENT_PROFILE=dev

# ============================================================================
# PROFILE-SPECIFIC OVERRIDES
# ============================================================================
# Uncomment and configure for specific profiles:
# Create separate files: .env.dev, .env.staging, .env.prod
#
# Example .env.dev (Development):
#   GIT_USER_EMAIL=dev.user@example.com
#   ENVIRONMENT_PROFILE=dev
#   GPG_SIGNING_ENABLED=false
#
# Example .env.prod (Production):
#   GIT_USER_EMAIL=prod.user@company.com
#   ENVIRONMENT_PROFILE=prod
#   GPG_SIGNING_ENABLED=true
#   GPG_KEY_ID=production-key-id

# ============================================================================
# SETUP INSTRUCTIONS
# ============================================================================
# 
# 1. Basic Setup (SSH):
#    GIT_USER_NAME=Your Name
#    GIT_USER_EMAIL=your@email.com
#    GITHUB_AUTH_METHOD=ssh
#    GITHUB_SSH_KEY_PATH=~/.ssh/id_ed25519
#
# 2. Generate SSH Key:
#    ssh-keygen -t ed25519 -C "your@email.com"
#    Add public key to GitHub: https://github.com/settings/keys
#
# 3. Test SSH Connection:
#    ssh -T git@github.com
#
# 4. Create Personal Access Token (HTTPS):
#    https://github.com/settings/tokens
#    Scopes: repo, read:user, user:email
#
# 5. Enable GPG Signing (Optional):
#    List keys: gpg --list-secret-keys --keyid-format LONG
#    Set GPG_SIGNING_ENABLED=true and add GPG_KEY_ID
#
# ============================================================================

# ============================================================================
# SERVICENOW INCIDENT OPERATIONS (Required for ServiceNow Agent)
# ============================================================================
# ServiceNow instance URL (must include protocol)
# Example: https://your-instance.service-now.com
SERVICENOW_HOST=

# ServiceNow integration username
SERVICENOW_USERNAME=

# ServiceNow integration password
SERVICENOW_PASSWORD=

# Comma-separated assignment group allowlist (names and/or sys_ids)
# Incidents outside this list will not be retrieved by ServiceNow skills/agent
SERVICENOW_ASSIGNMENT_GROUPS=

# ============================================================================
# SERVICENOW NOTES
# ============================================================================
# 1. Use a least-privilege account scoped to incident operations.
# 2. Never commit real credentials to version control.
# 3. Prefer a dedicated integration account over personal credentials.
# 4. Validate access to Incident table API before production use.
# ============================================================================

# ============================================================================
# JIRA CLOUD ISSUE OPERATIONS (Required for Jira Agent)
# ============================================================================
# Jira Cloud site URL (must include protocol)
# Example: https://your-domain.atlassian.net
JIRA_HOST=

# Jira Cloud user identifier (typically Atlassian account email)
JIRA_USERNAME=

# Jira Cloud API token
JIRA_API_TOKEN=

# Confluence space key(s) used by the Confluence agent and skills.
# Accepts a single key or a comma-separated list of keys.
# Examples: PLATFORM  |  PLATFORM,DEV,OPS
CONFLUENCE_SPACE_KEY=

# ============================================================================
# JIRA NOTES
# ============================================================================
# 1. Use a least-privilege integration account or dedicated automation user.
# 2. Never commit real credentials to version control.
# 3. Prefer scoped API tokens over personal passwords.
# 4. Validate access to projects, dashboards, issues, and Confluence space content before production use.
# ============================================================================

# ============================================================================
# NEW RELIC LOG OPERATIONS (Required for NewRelic Agent)
# ============================================================================
# New Relic User API Key (starts with NRAK-)
# Generate at: https://one.newrelic.com/api-keys
NEWRELIC_API_KEY=

# Comma-separated list of New Relic Account IDs to query.
# Examples: 1234567  |  1234567,2345678,3456789
NEWRELIC_ACCOUNT_IDS=

# ============================================================================
# NEW RELIC NOTES
# ============================================================================
# 1. Use a User API Key (NRAK-...) for NerdGraph/NRQL access.
# 2. Never commit real API keys to version control.
# 3. Account IDs can be found under: Admin > Account settings.
# 4. Least-privilege: scope access to log and metric read permissions only.
# ============================================================================

# ============================================================================
# AZURE DEVOPS GIT READ-ONLY OPERATIONS (Required for AzureGit Agent)
# ============================================================================
# Azure DevOps organization name (not URL)
# Example: my_org
AZURE_ORG=

# Comma-separated project allowlist used for scoped read-only operations
# Examples: project_1  |  project_1,project_2
AZURE_PROJECT=

# Azure DevOps Personal Access Token (read-only scopes recommended)
AZURE_PAT=

# Optional API version (defaults to 7.1 when omitted)
AZURE_API_VERSION=7.1

# ============================================================================
# AZURE DEVOPS NOTES
# ============================================================================
# 1. Use least-privilege PAT scopes focused on code read access.
# 2. Never commit real PAT values to version control.
# 3. Keep AZURE_PROJECT scoped to only projects you intend to query.
# 4. AZURE_API_VERSION is optional if using the default 7.1.
# ============================================================================

#!/bin/bash
# ============================================================================
# Git Pre-Commit Hook - Advisor Agent Integration
# ============================================================================
# Purpose: Automatically update README.md with file changes and prettify formatting
#
# Operations:
#   1. Detect staged file changes (create, modify, delete)
#   2. Generate/update README.md with change summary
#   3. Auto-detect file type and apply formatting rules
#   4. Stage updated README.md and formatted files
#
# Triggered: Before commit is finalized
# Skip: git commit --no-verify
# ============================================================================

set -e

HOOK_NAME="Advisor Pre-Commit Hook"
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
README_FILE="$PROJECT_ROOT/README.md"
CHANGES_LOG="$PROJECT_ROOT/.git/advisor-changes.log"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}${HOOK_NAME}${NC}"
echo "=================================================="

# ============================================================================
# PHASE 1: Detect File Changes
# ============================================================================

echo -e "${YELLOW}[PHASE 1] Detecting file changes...${NC}"

# Get list of staged files
STAGED_FILES=$(git diff --cached --name-only 2>/dev/null || echo "")
STAGED_ADDED=$(git diff --cached --name-only --diff-filter=A 2>/dev/null || echo "")
STAGED_MODIFIED=$(git diff --cached --name-only --diff-filter=M 2>/dev/null || echo "")
STAGED_DELETED=$(git diff --cached --name-only --diff-filter=D 2>/dev/null || echo "")

# Count changes
NUM_ADDED=$(echo "$STAGED_ADDED" | grep -c . || true)
NUM_MODIFIED=$(echo "$STAGED_MODIFIED" | grep -c . || true)
NUM_DELETED=$(echo "$STAGED_DELETED" | grep -c . || true)
TOTAL_CHANGES=$((NUM_ADDED + NUM_MODIFIED + NUM_DELETED))

if [ "$TOTAL_CHANGES" -eq 0 ]; then
  echo -e "${GREEN}✓ No file changes detected${NC}"
  exit 0
fi

echo -e "${GREEN}✓ Changes detected:${NC}"
echo "  Added: $NUM_ADDED files"
echo "  Modified: $NUM_MODIFIED files"
echo "  Deleted: $NUM_DELETED files"
echo "  Total: $TOTAL_CHANGES files"

# ============================================================================
# PHASE 2: Update README.md with Change Summary
# ============================================================================

echo ""
echo -e "${YELLOW}[PHASE 2] Updating README.md...${NC}"

# Create or update README.md
if [ ! -f "$README_FILE" ]; then
  echo -e "${YELLOW}Creating new README.md${NC}"
  cat > "$README_FILE" << 'EOF'
# Project Overview

This project contains GitHub Copilot AI tools agents and skills for advanced development workflows.

## Project Structure

```
├── .github/
│   ├── agents/              # AI agent definitions
│   │   ├── advisor.agent.md
│   │   ├── gitter.agent.md
│   │   ├── jira.agent.md
│   │   └── servicenow.agent.md
│   └── skills/              # Domain-specific skill implementations
│       └── gitter-credentials/
│           ├── SKILL.md
│           ├── SETUP.md
│           ├── README.md
│           ├── ARCHITECTURE.md
│           ├── gitter_credentials.py
│           └── gitter_credentials.js
│       └── servicenow-authentication/
│           ├── SKILL.md
│           └── servicenow_env.py
│       └── servicenow-incident-operations/
│           ├── SKILL.md
│           ├── README.md
│           └── servicenow_client.py
│       └── jira-authentication/
│           ├── SKILL.md
│           └── jira_env.py
│       └── jira-issue-operations/
│           ├── SKILL.md
│           ├── README.md
│           └── jira_client.py
├── docs/                    # Project and implementation documentation
├── scripts/                 # Operational and diagnostic scripts
│   └── servicenow/
│       └── *.py
├── git-hooks/               # Hook sources tracked in repo
├── .env.template            # Environment configuration template
├── .env.example             # Example configuration
├── .gitignore               # Git security excludes
└── README.md                # This file
```

## Agents

### Advisor Agent
Senior advisor specializing in GitHub Copilot AI tools architecture and enterprise adoption strategies.

### Gitter Agent
Expert Git workflow strategist for repository optimization and team collaboration.

### ServiceNow Agent
Incident/problem/issue lifecycle agent for secure ServiceNow communication.

### Jira Agent
Project/dashboard/issue lifecycle agent for secure Jira Cloud communication.

## Skills

### Gitter Credentials Skill
Secure credential management for Git operations with support for SSH keys, tokens, and GPG signing.

### ServiceNow Authentication Skill
Credential validation and normalization for ServiceNow host, username, and password loaded from `.env`.

### ServiceNow Incident Operations Skill
ServiceNow Incident, Problem, and Issue Table API operations for scoped lifecycle workflows.

### Jira Authentication Skill
Credential validation and normalization for Jira Cloud host, username, and API token loaded from `.env`.

### Jira Issue Operations Skill
Jira Cloud Project, Dashboard, and Issue API operations for lookup and controlled issue workflows.

## File Changes Log

This section is automatically maintained by pre-commit hooks.

### Latest Changes

_Updated by automated Advisor hook_

EOF
  echo -e "${GREEN}✓ README.md created${NC}"
else
  echo -e "${GREEN}✓ README.md exists, preparing update${NC}"
fi

# Create change summary
CHANGE_TIMESTAMP=$(date '+%Y-%m-%d %H:%M:%S')
CHANGE_SUMMARY=""

if [ -n "$STAGED_ADDED" ]; then
  CHANGE_SUMMARY="${CHANGE_SUMMARY}**New Files Added** ($NUM_ADDED):
"
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    # Determine file type and description
    if [[ "$file" == *.md ]]; then
      CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` - Documentation"$'\n'
    elif [[ "$file" == *.py ]]; then
      CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` - Python implementation"$'\n'
    elif [[ "$file" == *.js ]]; then
      CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` - JavaScript implementation"$'\n'
    elif [[ "$file" == .env* ]]; then
      CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` - Environment configuration"$'\n'
    elif [[ "$file" == .gitignore* ]]; then
      CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` - Git configuration"$'\n'
    else
      CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\`"$'\n'
    fi
  done <<< "$STAGED_ADDED"
  CHANGE_SUMMARY="${CHANGE_SUMMARY}"$'\n'
fi

if [ -n "$STAGED_MODIFIED" ]; then
  CHANGE_SUMMARY="${CHANGE_SUMMARY}**Files Modified** ($NUM_MODIFIED):
"
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    # Get line changes
    LINES=$(git diff --cached "$file" 2>/dev/null | grep -c "^+\|^-" || echo "")
    CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` - $LINES line changes"$'\n'
  done <<< "$STAGED_MODIFIED"
  CHANGE_SUMMARY="${CHANGE_SUMMARY}"$'\n'
fi

if [ -n "$STAGED_DELETED" ]; then
  CHANGE_SUMMARY="${CHANGE_SUMMARY}**Files Removed** ($NUM_DELETED):
"
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    CHANGE_SUMMARY="${CHANGE_SUMMARY}- \`$file\` (deleted)"$'\n'
  done <<< "$STAGED_DELETED"
  CHANGE_SUMMARY="${CHANGE_SUMMARY}"$'\n'
fi

# Update README.md with change log entry
# Replace "Latest Changes" section with new entry
if grep -q "### Latest Changes" "$README_FILE"; then
  # Extract content after "Latest Changes" marker
  HEAD=$(sed '/### Latest Changes/q' "$README_FILE")
  TAIL=$(sed -n '/### Latest Changes/,$p' "$README_FILE" | tail -n +4)
  
  # Create new entry
  NEW_ENTRY="_Updated: $CHANGE_TIMESTAMP by Advisor Hook_

#### Summary
$CHANGE_SUMMARY"
  
  # Combine and write
  {
    echo "$HEAD"
    echo ""
    echo "$NEW_ENTRY"
    echo ""
    echo "$TAIL"
  } > "$README_FILE"
  
  echo -e "${GREEN}✓ README.md updated with change summary${NC}"
else
  echo -e "${YELLOW}⚠ Latest Changes section not found, appending entry${NC}"
  {
    echo ""
    echo "## Recent Changes"
    echo ""
    echo "**Updated: $CHANGE_TIMESTAMP**"
    echo ""
    echo "$CHANGE_SUMMARY"
  } >> "$README_FILE"
fi

# ============================================================================
# PHASE 3: Prettify/Format Files
# ============================================================================

echo ""
echo -e "${YELLOW}[PHASE 3] Applying formatting rules...${NC}"

FORMAT_COUNT=0

# Format Python files
if command -v black &> /dev/null && [ -n "$STAGED_FILES" ]; then
  PYTHON_FILES=$(echo "$STAGED_FILES" | grep -E "\.py$" || true)
  if [ -n "$PYTHON_FILES" ]; then
    echo -e "${BLUE}Formatting Python files with black...${NC}"
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      if [ -f "$PROJECT_ROOT/$file" ]; then
        black "$PROJECT_ROOT/$file" --quiet 2>/dev/null || true
        git add "$file"
        ((FORMAT_COUNT++))
        echo -e "${GREEN}  ✓ Formatted: $file${NC}"
      fi
    done <<< "$PYTHON_FILES"
  fi
elif [ -n "$(echo "$STAGED_FILES" | grep -E "\.py$" || true)" ]; then
  echo -e "${YELLOW}⚠ black not installed, skipping Python formatting${NC}"
  echo "  Install: pip install black"
fi

# Format JavaScript files
if command -v prettier &> /dev/null && [ -n "$STAGED_FILES" ]; then
  JS_FILES=$(echo "$STAGED_FILES" | grep -E "\.(js|ts|json)$" || true)
  if [ -n "$JS_FILES" ]; then
    echo -e "${BLUE}Formatting JavaScript/JSON files with prettier...${NC}"
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      if [ -f "$PROJECT_ROOT/$file" ]; then
        prettier "$PROJECT_ROOT/$file" --write 2>/dev/null || true
        git add "$file"
        ((FORMAT_COUNT++))
        echo -e "${GREEN}  ✓ Formatted: $file${NC}"
      fi
    done <<< "$JS_FILES"
  fi
elif [ -n "$(echo "$STAGED_FILES" | grep -E "\.(js|ts|json)$" || true)" ]; then
  echo -e "${YELLOW}⚠ prettier not installed, skipping JavaScript formatting${NC}"
  echo "  Install: npm install -g prettier"
fi

# Format Markdown files
if command -v markdownlint &> /dev/null && [ -n "$STAGED_FILES" ]; then
  MD_FILES=$(echo "$STAGED_FILES" | grep -E "\.md$" || true)
  if [ -n "$MD_FILES" ]; then
    echo -e "${BLUE}Checking Markdown files...${NC}"
    while IFS= read -r file; do
      [ -z "$file" ] && continue
      if [ -f "$PROJECT_ROOT/$file" ]; then
        # Fix common markdown issues
        sed -i 's/  *$//' "$PROJECT_ROOT/$file"  # Remove trailing spaces
        sed -i '/^$/N;/^\n$/D' "$PROJECT_ROOT/$file"  # Remove multiple blank lines
        git add "$file"
        ((FORMAT_COUNT++))
        echo -e "${GREEN}  ✓ Cleaned: $file${NC}"
      fi
    done <<< "$MD_FILES"
  fi
fi

echo -e "${GREEN}✓ Formatting complete ($FORMAT_COUNT files)${NC}"

# ============================================================================
# PHASE 4: Final Checks
# ============================================================================

echo ""
echo -e "${YELLOW}[PHASE 4] Final checks...${NC}"

# Ensure README.md is staged
if [ -f "$README_FILE" ]; then
  git add "$README_FILE" 2>/dev/null || true
  echo -e "${GREEN}✓ README.md staged for commit${NC}"
fi

# Remove empty lines and unnecessary separators
if grep -q "^$" "$README_FILE" 2>/dev/null; then
  echo -e "${GREEN}✓ README.md validated${NC}"
fi

echo ""
echo -e "${GREEN}=================================================="
echo "✓ Pre-commit checks complete - Ready to commit"
echo "==================================================${NC}"

exit 0
